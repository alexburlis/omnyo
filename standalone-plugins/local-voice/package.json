{
  "name": "omnyo-plugin-local-voice",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/local-voice"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm build:helper && pnpm build:plugin",
    "build:helper": "node scripts/build-helper.mjs && node scripts/accept-helper.mjs",
    "build:plugin": "omnyo plugin build && node scripts/stage-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "opus-decoder": "0.7.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.46-3b89f84383f5.tgz",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "omnyo": ">=1.0.125",
    "omnyoPluginSdk": ">=0.6.45"
  },
  "packageManager": "pnpm@11.28.4",
  "omnyo": {
    "name": "Dictation by Paraspeech",
    "shortName": "Dictation",
    "description": "Private English dictation that runs on your Mac. Needs Apple silicon and macOS 14 or later.",
    "branding": {
      "icon": "Mic"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  }
}
