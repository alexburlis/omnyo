{
  "name": "omnyo-plugin-chat-topics",
  "version": "0.2.87",
  "private": true,
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/chat-topics"
  },
  "type": "module",
  "scripts": {
    "build": "omnyo plugin build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node scripts/check-node.mjs && node --test tests/*.test.ts",
    "test:e2e": "node tests/list.e2e.mjs",
    "package:runtime": "node ../package-runtime.mjs --plugin chat-topics --create-evidence-directory",
    "install:runtime": "node scripts/install-runtime.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.53-30740fa0f3c9.tgz",
    "@oxlint/plugins": "1.87.0",
    "@radix-ui/react-context-menu": "2.3.3",
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.11.1",
    "cron-parser": "5.10.2",
    "hono": "4.13.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "1.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "omnyo": ">=1.0.52",
    "omnyoPluginSdk": ">=0.6.53"
  },
  "packageManager": "pnpm@11.28.5",
  "omnyo": {
    "name": "Chat Topics",
    "description": "Short chat titles from the first response, chats sorted into status sections per project and in an Inbox, and type-of-work tags.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  }
}
