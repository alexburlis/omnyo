{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["server.ts", "host.ts", "app.tsx", "src", "tests", "scripts", "vitest.config.ts"]
}
