    "build": "omnyo plugin build",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "package:runtime": "node scripts/package-runtime.mjs",
    "install:runtime": "node scripts/install-runtime.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.46-3b89f84383f5.tgz",
    "@oxlint/plugins": "1.88.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^27.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typescript": "7.0.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "omnyo": ">=0.46.208",
