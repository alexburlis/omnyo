    "directory": "standalone-plugins/leftover-processes"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
    "format": "oxfmt .",
