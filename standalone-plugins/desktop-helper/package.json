  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/desktop-helper"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "native:build": "python3 scripts/native-build.py",
    "native:verify": "python3 scripts/native-verify.py",
    "build": "omnyo plugin build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
