    "format:check": "oxfmt --check .",
    "test:native-signature": "node --experimental-strip-types --test tests/native-signature.test.mjs"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.46-510c24583342.tgz",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^22.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "omnyo": ">=0.45",
    "omnyoPluginSdk": ">=0.6.46"
  },
  "packageManager": "pnpm@11.28.4",
  "omnyo": {
    "name": "Desktop Helper",
    "description": "Bounded native boundary proof for Mac desktop context.",
    "branding": {
      "icon": "MousePointer2"
