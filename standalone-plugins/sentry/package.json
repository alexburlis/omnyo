    "test:runtime-package": "node tests/runtime-package-journey.mjs"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.57-2aa65914a674.tgz",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "latest",
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
