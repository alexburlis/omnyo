{
  "name": "omnyo-plugin-canvas",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/canvas"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "omnyo plugin build && node scripts/stage-assets.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "install:runtime": "node scripts/install-runtime.mjs",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.0",
    "clsx": "2.1.1",
    "ipaddr.js": "2.5.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.55-d84be8ccb828.tgz",
    "@oxlint/plugins": "1.88.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "0.28.1",
    "hono": "^4.11.9",
    "jsdom": "^27.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "omnyo": ">=0.46.246",
    "omnyoPluginSdk": ">=0.6.55"
  },
  "packageManager": "pnpm@11.28.5",
  "omnyo": {
    "name": "Canvas",
    "description": "A shared canvas for each project, with linked chat boards, saved views and conversations beside the work.",
    "branding": {
      "icon": "GridView"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  }
}
