{
  "name": "omnyo-plugin-tidy",
  "version": "0.2.16",
  "private": true,
  "description": "Shows chats Omnyo recommends archiving, with their work reasons and workspace notes.",
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/tidy"
  },
  "type": "module",
  "scripts": {
    "lint:anti-slop": "oxlint --deny-warnings --format=agent",
    "lint": "npm run lint:anti-slop",
    "test": "node --test server.test.mjs readiness-store.test.mjs archive-store.test.mjs archive-approval.test.mjs",
    "typecheck": "tsc --noEmit",
    "package:runtime": "node ../package-runtime.mjs --plugin tidy",
    "install:runtime": "node scripts/install-runtime.mjs",
    "format:check": "oxfmt --check scripts server.ts server.test.mjs readiness-store.ts readiness-store.test.mjs archive-store.ts archive-store.test.mjs archive-approval.ts archive-approval.test.mjs archive-proposals.ts app.tsx ArchiveApproval.tsx components lib skills README.md PLUGIN_OVERVIEW.md package.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/plugin-sdk": "file:./vendor/omnyo-plugin-sdk-0.6.52-a6663b865ecc.tgz",
    "@oxlint/plugins": "1.85.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "4.13.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.85.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "overrides": {
    "hono@4.13.8": "4.13.11"
  },
  "engines": {
    "omnyo": ">=0.46.83",
    "omnyoPluginSdk": ">=0.6.52"
  },
  "omnyo": {
    "name": "Tidy",
    "description": "Ready to archive: chats recommended by Omnyo's shared work summary. You archive them.",
    "branding": {
      "icon": "Clean"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  }
}
