{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "app.tsx",
    "readiness-store.ts",
    "archive-store.ts",
    "archive-approval.ts",
    "archive-proposals.ts",
    "ArchiveApproval.tsx",
    "components",
    "lib",
    "hooks"
  ]
}
