{
  "name": "omnyo-plugin-skill-discovery",
  "version": "0.6.0",
  "private": true,
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexburlis/omnyo.git",
    "directory": "standalone-plugins/skill-discovery"
  },
  "type": "module",
  "scripts": {
    "build": "omnyo plugin build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --format=agent",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:invocation": "node --experimental-strip-types --test invocation.test.mjs",
    "test:catalogue": "node --experimental-strip-types --test catalogue.test.mjs",
    "test:prompts": "node --experimental-strip-types --test prompt.test.mjs",
    "test:library": "node --experimental-strip-types --test library.test.mjs",
    "test:pack": "node --experimental-strip-types --test pack.test.mjs",
    "test:curated": "node --experimental-strip-types --test curated*.test.mjs",
    "test:marketplace": "node --experimental-strip-types --test marketplace.test.mjs",
    "curated:refresh": "node --experimental-strip-types tools/refresh-curated.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "tar-stream": "3.1.7",
