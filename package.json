{
  "name": "omnyo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "turbo run generate:templates generate:plugin-scaffold generate generate:omnyo-official-marketplace --filter=@omnyo/templates --filter=@omnyo/plugin-build --filter=@omnyo/server --output-logs=errors-only --summarize=false",
    "scripts:prepare": "pnpm exec turbo run build --filter=@omnyo/scripts --output-logs=none --log-prefix=none --summarize=false",
    "cli:prepare": "pnpm exec turbo run build --filter=@omnyo/scripts --filter=@omnyo/cli --output-logs=none --log-prefix=none --summarize=false",
    "ensure-native-modules": "node scripts/ensure-native-modules.mjs",
    "dev": "node scripts/ensure-native-modules.mjs && cross-env NODE_ENV=development dotenv --no-expand -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-dev.ts",
    "start": "cross-env NODE_ENV=production dotenv --no-expand -c production -- node --conditions=source --import tsx scripts/start-omnyo.mjs",
    "start:worktree": "cross-env NODE_ENV=development dotenv --no-expand -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-dev.ts --worktree",
    "start:worktree-remote": "cross-env OMNYO_SERVER_BIND_HOST=0.0.0.0 pnpm run start:worktree",
    "desktop": "cross-env NODE_ENV=production dotenv --no-expand -c production -- node --conditions=source --import tsx packages/scripts/src/commands/run-desktop.ts",
    "desktop:worktree": "cross-env NODE_ENV=development dotenv --no-expand -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-desktop.ts --worktree",
    "mobile:apk:dev": "pnpm exec turbo run build:android:dev --filter=@omnyo/mobile",
    "dev:remote": "cross-env OMNYO_DEV_APP_HOST=0.0.0.0 OMNYO_SERVER_BIND_HOST=0.0.0.0 pnpm run dev",
    "dev:restart": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts both",
    "dev:restart-server": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts server",
    "dev:restart-host-daemon": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts host-daemon",
    "dev:host-daemon": "cross-env NODE_ENV=development dotenv --no-expand -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-host-daemon.ts",
    "build": "turbo run build --filter=@omnyo/scripts --filter=@omnyo/app --filter=@omnyo/server --filter=@omnyo/host-daemon --filter=@omnyo/cli --filter=omnyo-app",
    "public:mac-release": "node scripts/public-mac-release.mjs",
    "omnyo-app:prepare": "turbo run build --filter=omnyo-app --output-logs=none --log-prefix=none --summarize=false",
    "start:host-daemon": "cross-env NODE_ENV=production dotenv --no-expand -c production -- pnpm run --silent omnyo-app:prepare && cross-env NODE_ENV=production dotenv --no-expand -c production -- node packages/omnyo-app/dist/omnyo-app.js host-daemon",
    "seed:perf": "node scripts/ensure-native-modules.mjs && cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/seed-perf-db.ts",
    "parity": "pnpm --filter @omnyo/provider-parity run parity",
    "reset": "cross-env NODE_ENV=production pnpm run --silent scripts:prepare && cross-env NODE_ENV=production node packages/scripts/dist/commands/reset-omnyo-data.js",
    "reset:dev": "cross-env NODE_ENV=development pnpm run --silent scripts:prepare && cross-env NODE_ENV=development node packages/scripts/dist/commands/reset-omnyo-data.js",
    "reset:all": "cross-env NODE_ENV=production pnpm run --silent scripts:prepare && cross-env NODE_ENV=production node packages/scripts/dist/commands/reset-omnyo-data.js --all",
    "clean": "turbo run clean",
    "codemod:remove-typescript-comments": "node scripts/remove-typescript-comments.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "storybook": "turbo run storybook --filter=@omnyo/app",
    "lint": "turbo run lint",
    "check:plugin-forks": "node scripts/check-plugin-forks.mjs",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/test-modes.mjs dev",
    "test:dev": "node scripts/test-modes.mjs dev",
    "test:full": "node scripts/test-modes.mjs full",
    "test:integration": "turbo run test:integration",
    "qa:standalone:start": "node tests/qa/scripts/run-root-command.mjs standalone:start",
    "qa:standalone:stop": "node tests/qa/scripts/run-root-command.mjs standalone:stop",
    "qa:standalone:cleanup": "node tests/qa/scripts/run-root-command.mjs standalone:cleanup",
    "codex:archive-tmp-omnyo-sessions": "pnpm run --silent scripts:prepare && node packages/scripts/dist/commands/archive-codex-tmp-omnyo-sessions.js",
    "omnyo": "cross-env NODE_ENV=production pnpm run --silent cli:prepare 1>&2 && cross-env NODE_ENV=production node packages/scripts/dist/commands/run-cli.js",
    "omnyo:dev": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/run-cli.ts",
    "server": "pnpm --filter @omnyo/server start",
    "drizzle-studio": "cross-env NODE_ENV=development pnpm --filter @omnyo/db db:studio",
    "drizzle-studio:prod": "cross-env NODE_ENV=production pnpm --filter @omnyo/db db:studio",
    "lint:advisory": "oxlint --config .oxlintrc-advisory.json ."
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@vitest/coverage-v8": "4.1.11",
