{
  "name": "@omnyo/desktop",
  "version": "1.0.171",
  "private": true,
  "desktopProfileAdoptionProtocol": 2,
  "description": "macOS, Linux, and Windows Electron shell for Omnyo",
  "main": "dist/main.js",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist release",
    "desktop:build": "pnpm run build && node scripts/run-electron-builder.mjs --mac --arm64",
    "desktop:build:linux": "pnpm run build && node scripts/run-electron-builder.mjs --linux --x64",
    "desktop:build:win": "pnpm run build && node scripts/run-electron-builder.mjs --win --x64",
    "desktop:public-update-feed": "tsx --conditions=source scripts/generate-public-update-feed.mts",
    "desktop:version-feed": "tsx scripts/generate-version-feed.mts",
    "dev": "pnpm run prepare-runtime && pnpm run build && node --conditions=source --import tsx scripts/run-electron-dev.mjs",
    "package": "pnpm run prepare-runtime && pnpm run build && node scripts/run-electron-builder.mjs --mac --dir --arm64",
    "package:linux": "pnpm run prepare-runtime && pnpm run build && node scripts/run-electron-builder.mjs --linux --dir --x64",
    "package:win": "pnpm run prepare-runtime && pnpm run build && node scripts/run-electron-builder.mjs --win --dir --x64",
    "prepare-runtime": "pnpm exec turbo run build --filter=omnyo-app --output-logs=new-only",
    "smoke:appimage-lifecycle": "node scripts/smoke-linux-appimage-lifecycle.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "smoke:packaged-npm": "node scripts/smoke-packaged-npm.mjs",
    "smoke:browser-cdp": "node scripts/smoke-browser-cdp.mjs",
    "start": "pnpm run package && node scripts/run-packaged-app.mjs",
    "test:prepare": "install-electron",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke:browser-broker": "node scripts/smoke-browser-broker.mjs"
  },
  "dependencies": {
    "@electron/asar": "3.4.1",
    "@omnyo/connect-client": "workspace:*",
    "@omnyo/host-daemon-contract": "workspace:*",
    "omnyo-app": "workspace:*",
    "electron-updater": "^6.8.3",
    "semver": "^7.7.0",
    "unzipper": "0.12.5",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/config": "workspace:*",
    "@omnyo/desktop-contract": "workspace:*",
    "@omnyo/domain": "workspace:*",
    "@omnyo/server-archive": "workspace:*",
    "@omnyo/server-contract": "workspace:*",
    "@omnyo/text-utils": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^24.9.0",
    "@types/semver": "^7.7.0",
    "@types/unzipper": "0.10.11",
    "@types/ws": "^8.18.1",
    "electron": "44.9.3",
    "electron-builder": "^26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.8.3"
  }
}
