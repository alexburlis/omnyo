{
  "name": "@omnyo/server",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "omnyoTestOptIn": [
    "test/provider-corpus",
    "test/performance/history-stalls.bench.test.ts",
    "test/performance/ingress-lock-burst.bench.test.ts"
  ],
  "scripts": {
    "build": "node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --external ./start-server.js --copy-dir ../../packages/db/drizzle dist/drizzle --copy-dir src/assets dist/assets && node --import tsx scripts/copy-builtin-skills.ts && node ../../scripts/build-node-entry.mjs src/start-server.ts dist/start-server.js && node ../../scripts/build-node-entry.mjs ../../packages/plugin-sdk/src/index.ts dist/plugin-sdk-runtime.js && node ../../scripts/build-node-entry.mjs src/services/plugins/zod-runtime.ts dist/zod-runtime.js && node ../../scripts/build-node-entry.mjs src/services/threads/timeline-worker.ts dist/timeline-worker.js && node ../../scripts/build-node-entry.mjs src/omnyo-identity-adoption.ts dist/omnyo-identity-adoption.js && node scripts/build-origin-adoption-v1.mjs && node scripts/build-stall-resource-sampler.mjs",
    "start": "node dist/index.js",
    "dev": "node --conditions=source --import tsx scripts/dev-supervisor.mjs",
    "clean": "rimraf dist",
    "generate:omnyo-official-marketplace": "node --conditions=source --import tsx scripts/generate-omnyo-official-marketplace.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:provider-corpus": "vitest run --config vitest.config.ts test/provider-corpus"
  },
  "dependencies": {
    "@omnyo/config": "workspace:*",
    "@omnyo/core-ui": "workspace:*",
    "@omnyo/db": "workspace:*",
    "@omnyo/domain": "workspace:*",
    "@omnyo/file-transfer": "workspace:*",
    "@omnyo/host-daemon-contract": "workspace:*",
    "@omnyo/logger": "workspace:*",
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/process-utils": "workspace:*",
    "@omnyo/sdk": "workspace:*",
    "@omnyo/secret-storage": "workspace:*",
    "@omnyo/server-archive": "workspace:*",
    "@omnyo/server-contract": "workspace:*",
    "@omnyo/templates": "workspace:*",
    "@omnyo/text-utils": "workspace:*",
    "@omnyo/thread-view": "workspace:*",
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@omnyo/plugin-sdk": "workspace:*",
    "@hono/node-server": "2.1.6",
    "@hono/node-ws": "^1.3.0",
    "@opentelemetry/api": "1.9.1",
    "acorn": "8.16.0",
    "acorn-walk": "8.3.5",
    "better-auth": "^1.7.14",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.18",
    "mime-types": "^3.0.2",
    "npm": "11.16.0",
    "parse5": "8.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "semver": "^7.7.0",
    "sharp": "0.35.5",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@omnyo/agent-runtime": "workspace:*",
    "@omnyo/client-core": "workspace:*",
    "@omnyo/scripts": "workspace:*",
    "@omnyo/test-helpers": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@omnyo/tunnel-client": "workspace:*",
    "@omnyo/tunnel-contract": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@types/ws": "^8.18.1",
    "ajv": "8.20.0",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11"
  }
}
