    "@omnyo/local-open-targets": "workspace:*",
    "@omnyo/host-watcher": "workspace:*",
    "@omnyo/host-workspace": "workspace:*",
    "@omnyo/logger": "workspace:*",
    "@omnyo/process-utils": "workspace:*",
    "@omnyo/provider-bridge-protocol": "workspace:*",
    "@omnyo/server-archive": "workspace:*",
    "@omnyo/server-contract": "workspace:*",
    "@omnyo/text-utils": "workspace:*",
    "@omnyo/tunnel-client": "workspace:*",
    "@omnyo/tunnel-contract": "workspace:*",
    "@hono/node-server": "1.19.15",
    "@parcel/watcher": "2.5.6",
    "gray-matter": "^4.0.3",
    "mime-types": "^3.0.2",
    "node-pty": "1.2.0-beta.15",
