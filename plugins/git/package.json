{
  "name": "omnyo-plugin-omnyo--git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shows a thread's branch, changes, commits, and pull request in one control in the thread header.",
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "engines": {
    "omnyo": ">=0.0",
    "omnyoPluginSdk": ">=0.4.102 >=0.6.44"
  },
  "omnyo": {
    "name": "Git",
    "description": "Shows a thread's branch, changes, commits, and pull request in one control in the thread header.",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "omnyo-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "omnyo-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@omnyo/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.11"
  }
}
