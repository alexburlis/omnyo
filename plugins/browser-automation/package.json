{
  "name": "omnyo-plugin-browser-automation",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Let Omnyo control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
  "author": {
    "name": "Omnyo",
    "url": "https://omnyohq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/browser-automation"
  },
  "engines": {
    "omnyo": ">=0.41",
    "omnyoPluginSdk": ">=0.4.102 >=0.6.44"
  },
  "omnyo": {
    "name": "Browser Automation",
    "description": "Let Omnyo control the in-app browser and browsers on connected machines, with inline previews for headless sessions.",
    "branding": {
      "icon": "Globe"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "node ../../apps/cli/dist/index.js plugin build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "smoke": "tsx --tsconfig tsconfig.smoke.json smoke.ts",
    "smoke:deltas": "tsx --tsconfig tsconfig.smoke.json smoke-deltas.ts",
    "smoke:install": "tsx --tsconfig tsconfig.smoke.json smoke-install.ts",
    "prepare:bundled": "omnyo-plugin-build prepare-bundled",
    "smoke:visuals": "tsx --tsconfig tsconfig.smoke.json smoke-visuals.ts"
  },
  "dependencies": {
    "@omnyo/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.13.18",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.11"
  }
}
