{
  "name": "omnyo-plugin-secrets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Securely request credentials from a user and reconcile them into dotenv files.",
  "author": {
    "name": "bb",
    "url": "https://github.com/get-bb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/secrets"
  },
  "engines": {
    "omnyo": ">=0.0",
    "omnyoPluginSdk": ">=0.4.102 >=0.6.44"
  },
  "omnyo": {
    "name": "Secrets",
    "description": "Securely request credentials from a user and reconcile them into dotenv files.",
    "branding": {
      "icon": "Lock"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "omnyo-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "omnyo-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@omnyo/shared-ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.3.4",
    "@hugeicons/react": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.1",
    "hono": "4.13.18",
    "react": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.11"
  }
}
