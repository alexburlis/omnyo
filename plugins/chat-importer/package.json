{
  "name": "omnyo-plugin-omnyo--chat-importer",
  "version": "0.1.0",
  "description": "Import recent Codex CLI and Claude Code chats so you can continue them in Omnyo.",
  "author": {
    "name": "Omnyo",
    "url": "https://github.com/alexburlis"
  },
  "private": true,
  "type": "module",
  "engines": {
    "omnyo": ">=0.0",
    "omnyoPluginSdk": ">=0.6.27 >=0.6.44"
  },
  "omnyo": {
    "name": "Chat Import",
    "description": "Import recent Codex CLI and Claude Code chats so you can continue them in Omnyo.",
    "branding": {
      "icon": "MessagesSquare"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "host": "./src/host.ts"
  },
  "keywords": [
    "omnyo-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "omnyo-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@omnyo/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/plugin-sdk": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.11"
  }
