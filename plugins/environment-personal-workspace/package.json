{
  "name": "omnyo-plugin-environment-personal-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Give every thread without a project its own personal workspace on the machine",
  "author": {
    "name": "bb",
    "url": "https://github.com/get-bb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
