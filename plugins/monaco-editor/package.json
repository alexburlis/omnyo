{
  "name": "omnyo-plugin-monaco-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edit files in Omnyo with the Monaco editor instead of the read-only preview.",
  "license": "MIT",
  "homepage": "https://github.com/example/omnyo",
  "bugs": {
    "url": "https://github.com/example/omnyo/issues"
  },
  "author": {
