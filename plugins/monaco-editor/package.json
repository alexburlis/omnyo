  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/monaco-editor"
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "README.md"
  ],
  "engines": {
