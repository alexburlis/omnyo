{
  "name": "omnyo-plugin-pdf-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preview PDF files with the browser's built-in viewer.",
  "author": {
    "name": "bb",
    "url": "https://github.com/get-bb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/pdf-preview"
  },
  "engines": {
    "omnyo": ">=0.0",
