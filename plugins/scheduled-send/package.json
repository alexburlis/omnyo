{
  "name": "omnyo-plugin-scheduled-send",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schedule the current composer draft to send at a later time.",
  "author": {
    "name": "bb",
    "url": "https://github.com/get-bb"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
