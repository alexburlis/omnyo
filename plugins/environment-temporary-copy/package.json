{
  "name": "omnyo-plugin-environment-temporary-copy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run a waiting chat on a free machine in a temporary copy of its project",
  "author": {
    "name": "alexburlis",
    "url": "https://github.com/alexburlis"
  },
  "engines": {
    "omnyo": ">=0.0"
  },
  "omnyo": {
    "name": "Temporary Copy",
    "description": "Run a waiting chat on a free machine in a temporary copy of its project",
    "branding": {
      "icon": "Copy"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "keywords": [
    "omnyo-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare:bundled": "omnyo-plugin-build prepare-bundled"
  },
  "dependencies": {
    "omnyo-environment-provider-host": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/plugin-build": "workspace:*",
    "@omnyo/plugin-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "4.1.11"
  }
}
