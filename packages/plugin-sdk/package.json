  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:types": "node --max-semi-space-size=64 scripts/build-bundled-dts.mjs --group testing",
    "clean": "rimraf bundled-types dist tsconfig.tsbuildinfo",
    "prepack": "pnpm --workspace-root exec turbo run build:types build --filter=@omnyo/plugin-sdk --concurrency=1",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build:types:backend": "node --max-semi-space-size=64 scripts/build-bundled-dts.mjs --group backend",
    "build:types:providers": "node --max-semi-space-size=64 scripts/build-bundled-dts.mjs --group providers",
    "build:types:app": "node --max-semi-space-size=64 scripts/build-bundled-dts.mjs --group app",
    "build:types:internal": "node --max-semi-space-size=64 scripts/build-bundled-dts.mjs --group internal",
    "pack:private": "node scripts/pack-private.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
