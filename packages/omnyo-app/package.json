{
  "name": "omnyo-app",
  "version": "1.0.183",
  "private": true,
  "description": "Private Omnyo app launcher",
  "keywords": [
    "omnyo",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/example/omnyo",
  "bugs": {
    "url": "https://github.com/example/omnyo/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/omnyo-app.js": "./dist/omnyo-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "omnyo-app": "dist/omnyo-app.js",
    "omnyo": "dist/omnyo.js",
    "omnyo-server": "dist/omnyo-server.js",
    "omnyo-host-daemon": "dist/omnyo-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "host-daemon/dist/omnyo",
    "host-daemon/dist/omnyo.cmd",
    "host-daemon/dist/omnyo-chunks",
    "host-daemon/dist/omnyo-file-search-worker.mjs",
    "host-daemon/dist/omnyo-parcel-watcher-child.mjs",
    "host-daemon/dist/omnyo-plugin-host-worker.mjs",
    "host-daemon/dist/omnyo-process-launcher-worker.mjs",
    "host-daemon/dist/omnyo-provider-bridge-worker.mjs",
    "host-daemon/dist/omnyo-workspace-observer-child.mjs",
    "host-daemon/dist/omnyo-workspace-read-child.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "README.md",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "prepack": "node dist/prune-omnyo-chunks.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "13.0.3",
    "fs-native-extensions": "1.5.0",
    "hono": "^4.13.18",
    "node-pty": "1.2.0-beta.15",
    "npm": "11.16.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@omnyo/domain": "workspace:*",
    "@omnyo/config": "workspace:*",
    "@omnyo/host-daemon-contract": "workspace:*",
    "@omnyo/sdk": "workspace:*",
    "@omnyo/server-archive": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "semver": "^7.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
