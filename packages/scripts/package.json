{
  "name": "@omnyo/scripts",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "bin": {
    "omnyo-script-archive-codex-tmp-omnyo-sessions": "./dist/commands/archive-codex-tmp-omnyo-sessions.js",
    "omnyo-script-reset-omnyo-data": "./dist/commands/reset-omnyo-data.js",
    "omnyo-script-run-cli": "./dist/commands/run-cli.js"
  },
  "exports": {
    "./lib/run-dev-supervisor": {
      "source": "./src/lib/run-dev-supervisor.ts",
      "types": "./src/lib/run-dev-supervisor.ts",
      "import": "./dist/lib/run-dev-supervisor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node ../../scripts/build-node-entry.mjs src/commands/report-harness-efficiency.ts dist/commands/report-harness-efficiency.js",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@omnyo/config": "workspace:*",
    "@omnyo/db": "workspace:*",
    "@omnyo/domain": "workspace:*",
    "@omnyo/host-daemon-contract": "workspace:*",
    "@omnyo/process-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11"
  }
}
