{
  "name": "@omnyo/host-daemon-contract",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./host-artifact-signature": {
      "source": "./src/host-artifact-signature.ts",
      "types": "./src/host-artifact-signature.ts",
      "default": "./src/host-artifact-signature.ts"
    },
    "./local": {
      "source": "./src/local.ts",
      "types": "./src/local.ts",
      "default": "./src/local.ts"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./workspace": {
      "source": "./src/workspace.ts",
      "types": "./src/workspace.ts",
      "default": "./src/workspace.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@omnyo/domain": "workspace:*",
    "@omnyo/hono-typed-routes": "workspace:*",
    "@omnyo/provider-bridge-protocol": "workspace:*",
    "hono": "^4.13.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/test-helpers": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
