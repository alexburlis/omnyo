{
  "name": "@omnyo/server-archive",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./test/omnyo-root-fixture": {
      "source": "./test/omnyo-root-fixture.ts",
      "types": "./test/omnyo-root-fixture.ts",
      "default": "./test/omnyo-root-fixture.ts"
    },
    "./runtime-identity": {
      "source": "./src/runtime-identity.ts",
      "types": "./src/runtime-identity.ts",
      "default": "./src/runtime-identity.ts"
    },
    "./json-file": {
      "source": "./src/json-file.ts",
      "types": "./src/json-file.ts",
      "default": "./src/json-file.ts"
    },
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test/omnyo-worker-root-fixture": {
      "source": "./test/omnyo-worker-root-fixture.ts",
      "types": "./test/omnyo-worker-root-fixture.ts",
      "default": "./test/omnyo-worker-root-fixture.ts"
    },
    "./test/omnyo-worker-runtime-fixture": {
      "source": "./test/omnyo-worker-runtime-fixture.ts",
      "types": "./test/omnyo-worker-runtime-fixture.ts",
      "default": "./test/omnyo-worker-runtime-fixture.ts"
    },
    "./mac-state-acl-v1": {
      "types": "./mac-state-acl-v1.d.mts",
      "default": "./mac-state-acl-v1.mjs"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@omnyo/config": "workspace:*",
    "@omnyo/domain": "workspace:*",
    "tar": "7.5.22",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/db": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.11"
  }
}
