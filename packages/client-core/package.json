{
  "name": "@omnyo/client-core",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./route-paths": {
      "source": "./src/routes/route-paths.ts",
      "types": "./src/routes/route-paths.ts",
      "default": "./src/routes/route-paths.ts"
    },
    "./prompt-draft": {
      "source": "./src/prompt/prompt-draft.ts",
      "types": "./src/prompt/prompt-draft.ts",
      "default": "./src/prompt/prompt-draft.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@omnyo/core-ui": "workspace:*",
    "@omnyo/desktop-contract": "workspace:*",
    "@omnyo/domain": "workspace:*",
    "@omnyo/fuzzy-match": "workspace:*",
    "@omnyo/server-contract": "workspace:*",
    "@omnyo/text-utils": "workspace:*",
    "@omnyo/thread-view": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@omnyo/test-helpers": "workspace:*",
    "@omnyo/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "@omnyo/plugin-sdk": "workspace:*"
  }
}
